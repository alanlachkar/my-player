{
  "name": "my-player",
  "version": "0.0.1",
  "description": "My Player is a React TS web app that can play video stream.",
  "main": "index.tsx",
  "keywords": [
    "react",
    "typescript",
    "github-action",
    "git-hooks"
  ],
  "author": "alan",
  "license": "MIT",
  "homepage": "https://github.com/alanlachkar/my-player#readme",
  "devDependencies": {
    "@babel/core": "^7.25.7",
    "@babel/plugin-proposal-class-properties": "^7.17.12",
    "@babel/plugin-transform-runtime": "^7.25.7",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@babel/preset-typescript": "^7.26.0",
    "@cypress/code-coverage": "^3.13.7",
    "@cypress/webpack-preprocessor": "^6.0.2",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^15.0.7",
    "@types/chai": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.2.1",
    "babel-plugin-istanbul": "^7.0.0",
    "babel-preset-react": "^6.24.1",
    "chai": "^5.1.2",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "cypress": "13.16.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.7.0",
    "mini-css-extract-plugin": "^2.9.2",
    "nyc": "^17.1.0",
    "prettier": "3.4.1",
    "start-server-and-test": "^2.0.8",
    "style-loader": "^4.0.0",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/icons-material": "^5.16.8",
    "@mui/material": "^5.16.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "axios": "^1.7.8",
    "file-loader": "^6.2.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.1",
    "rx-player": "^4.2.0",
    "typescript": "^5.7.2",
    "url-loader": "^4.1.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.jest/fileMock.js",
      "\\.(css|less)$": "<rootDir>/.jest/styleMock.js"
    },
    "coverageDirectory": ".coverage/jest-coverage",
    "collectCoverage": true,
    "testPathIgnorePatterns": [
      "<rootDir>/cypress/"
    ]
  },
  "nyc": {
    "extends": "@istanbuljs/nyc-config-typescript",
    "report-dir": ".coverage/cypress-coverage",
    "extensions": [
      "js",
      "jsx",
      "ts",
      "tsx"
    ],
    "all": true,
    "compact": false,
    "excludeAfterRemap": false,
    "exclude": [
      "build",
      "cypress/plugins",
      "cypress/support",
      "dist"
    ]
  },
  "scripts": {
    "start": "webpack serve --config webpack.dev.js",
    "build": "webpack --config webpack.prod.js",
    "cy:open": "cypress open --e2e",
    "cy:run": "cypress run --e2e",
    "it": "start-server-and-test start http://localhost:8082 cy:run",
    "ut": "jest --coverage",
    "reports:move": "cp .coverage/cypress-coverage/coverage-final.json .coverage/coverage-final-from-cypress.json || copy .coverage/cypress-coverage/coverage-final.json .coverage/coverage-final-from-cypress.json && cp .coverage/jest-coverage/coverage-final.json .coverage/coverage-final-from-jest.json || copy .coverage/jest-coverage/coverage-final.json .coverage/coverage-final-from-jest.json ",
    "reports:merge": "yarn reports:move && npx nyc merge .coverage coverage.json && mv coverage.json .nyc_output/out.json || move coverage.json .nyc_output/out.json",
    "reports:combined": "npx nyc report --reporter lcov --reporter text --report-dir .coverage/combined && rm .coverage/coverage-final-from-cypress.json || del .coverage/coverage-final-from-cypress.json && rm .coverage/coverage-final-from-jest.json || del .coverage/coverage-final-from-jest.json",
    "reports:coverage": "yarn it && yarn ut && yarn reports:merge && yarn reports:combined"
  },
  "proxy": "http://localhost:9292"
}
